# ---- Frontend (Vite) ----
# Base URL of the sync API (no trailing slash). In prod behind nginx it is
# usually the same-origin subpath, e.g. /flashcards/api
VITE_API_BASE_URL=http://localhost:3000

# ---- Server (node server/index.js) ----
# CORS_ORIGIN=http://localhost:5173
# JWT_SECRET=change-me-in-production
# PORT=3000
# UPLOAD_DIR=./server/uploads

# ---- Email (for verification + password reset) ----
# If SMTP_HOST is empty the server falls back to a stub transport that prints
# the verification code to stdout (docker logs). Set real SMTP for production.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourmail@example.com
# SMTP_PASS=app-password
# MAIL_FROM="Карточки <no-reply@example.com>"
