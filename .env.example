# ---- Frontend (Vite) ----
# Base URL of the sync API (no trailing slash). In prod behind nginx it is
# usually the same-origin subpath, e.g. /flashcards/api
# Production uses `.env.production` (see repo); copy here for local prod builds.
VITE_API_BASE_URL=http://localhost:3000

# ---- Server (node server/index.js) ----
# For production Docker on the host, use a single file `api.env` (see
# `api.env.example` and `scripts/restart-flashcards-api.sh`), not this file.
# CORS_ORIGIN=http://localhost:5173
# JWT_SECRET=change-me-in-production
# PORT=3000
# UPLOAD_DIR=./server/uploads
