# Copy to `api.env` on the server, chmod 600, never commit.
# Single file for the flashcards-api container (docker --env-file).

NODE_ENV=production
PORT=3000

# Long random string; changing it invalidates all existing JWTs.
JWT_SECRET=replace-with-openssl-rand-hex-32

# Where the PWA and API are opened from (browser Origin for CORS).
CORS_ORIGIN=https://kzt24.duckdns.org

# --- Outbound e-mail ---
#
# (A) Self-hosted Postfix on the same host (see scripts/restart-flashcards-postfix.sh).
#     MAIL_FROM must use the same domain as ALLOWED_SENDER_DOMAINS on Postfix.
# SMTP_HOST=flashcards-postfix
# SMTP_PORT=587
# SMTP_TLS_INSECURE=true
# MAIL_FROM="Карточки <noreply@kzt24.duckdns.org>"
#
# (B) External SMTP (Gmail, Yandex, …) — set USER/PASS and turn off TLS_INSECURE.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# SMTP_TLS_INSECURE=false
# MAIL_FROM="Карточки <you@gmail.com>"
#
# If SMTP_HOST is empty, the API logs verification codes to stdout (docker logs).
