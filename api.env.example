# Copy to `api.env` on the server, chmod 600, never commit.
# Single file for the flashcards-api container (docker --env-file).

NODE_ENV=production
PORT=3000

# Long random string; changing it invalidates all existing JWTs.
JWT_SECRET=replace-with-openssl-rand-hex-32

# Where the PWA and API are opened from (browser Origin for CORS).
CORS_ORIGIN=https://kzt24.duckdns.org

# --- Outbound e-mail (omit these lines to use stub: codes in docker logs) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=google-app-specific-password-16-chars
# MAIL_FROM="Карточки <you@gmail.com>"

# Yandex: often SMTP 465 + SMTP_SECURE=true
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@yandex.ru
# SMTP_PASS=app-password
# MAIL_FROM="Карточки <you@yandex.ru>"
